# Copy to .env and change every CHANGE_ME value. Never commit .env.
POSTGRES_PASSWORD=CHANGE_ME_local_db_password
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ADI_JWT_SECRET=CHANGE_ME_at_least_32_random_characters_long
ADI_ENV=development
ADI_COOKIE_SECURE=false
ADI_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
ADI_LOG_JSON=true
# Password for the demo users created by `python -m app.cli demo` (min 12 chars).
ADI_DEMO_PASSWORD=CHANGE_ME_demo_password

# --- AI provider ---
# "auto": Claude when ANTHROPIC_API_KEY is set, otherwise offline mode (no LLM).
ADI_LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...        # enables Claude; retrieved code chunks are then sent to Anthropic
ADI_CLAUDE_MODEL=claude-opus-5-5
ADI_CLAUDE_EFFORT=medium

# Optional (AWS): store imported archives in S3 instead of the local volume.
# ADI_S3_BUCKET=
